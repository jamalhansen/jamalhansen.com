#!/bin/bash
# Blog code block validator — pre-commit hook.
#
# Install into your blog repo:
#   cp /path/to/blog-code-block-validator/scripts/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Requires blog-validate installed:
#   uv tool install /path/to/blog-code-block-validator

if ! command -v blog-validate &> /dev/null; then
    echo "Warning: blog-validate not found in PATH."
    echo "Install it with: uv tool install /Users/jamalhansen/projects/blog-code-block-validator"
    exit 0 # Don't block commit if tool is missing, just warn
fi

blog-validate check --changed

if [ $? -ne 0 ]; then
    echo ""
    echo "Fix failing code blocks before committing."
    echo "To skip this check: git commit --no-verify"
    exit 1
fi

# Frontmatter shape of staged posts (nested blocks, missing description, cover without alt, ...).
# Keep /now/ current: data/now.json is regenerated from the local fleet on every commit.
if [ -x scripts/refresh-now ]; then
    python3 scripts/refresh-now >/dev/null 2>&1 && git add data/now.json
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- 'content/blog/**/index.md' 'content/blog/*/index.md')
if [ -n "$staged" ]; then
    if command -v obsidian-hugo &> /dev/null; then
        # shellcheck disable=SC2086
        obsidian-hugo check --hugo-dir . $staged || {
            echo ""
            echo "Fix the frontmatter errors above before committing."
            echo "To skip this check: git commit --no-verify"
            exit 1
        }
    else
        echo "Warning: obsidian-hugo not found; frontmatter not checked."
        echo "Install it with: uv tool install ~/projects/local-first/obsidian-hugo-bridge"
    fi
fi
